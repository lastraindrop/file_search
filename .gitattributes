# Normalize line endings: shell scripts must stay LF for Linux CI, batch files CRLF.
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.yml text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text
*.js text
*.css text
*.html text
*.md text
